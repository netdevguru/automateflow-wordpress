# Everything here is development scaffolding, not part of the plugin users install.
# `wp dist-archive` and the wp.org deploy actions read this file.

.git
.gitattributes
.gitignore
.github
.distignore
.editorconfig

# Development tooling
phpcs.xml.dist
phpcs.xml
composer.json
composer.lock
vendor
node_modules
package.json
package-lock.json

# GitHub-facing docs and working notes; wp.org reads readme.txt instead, which is not
# matched by this pattern because it is lowercase .txt. Anything else ending in .md is
# development scaffolding — Plugin Check reports, review notes — and must not ship.
*.md

# wp.org serves screenshots and banners from the SVN /assets directory, not from the
# plugin ZIP, so anything staged for that must not ship to users.
.wordpress-org

# Correspondence with the review team. Kept in the repo for context, but it is not part of
# the plugin and shipping it to users would leak a private thread — this file was caught in
# a built archive once already.
*.eml
dist
